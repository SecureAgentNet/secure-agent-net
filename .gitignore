# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
build/
dist/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets — never commit these
.env
.env.*
!.env.example
.deploy.env
deployment/certs/
*.key
*.pem
*.p12
scripts/deploy_website.sh

# Node / website build deps
node_modules/

# Local runtime data and scratch space
uploads/
scratch/
backups/
*.log

# Local tool state
.agent/
.stitch-mcp/
.claude/settings.local.json
.idea/
.vscode/
.DS_Store
# Email agent runtime output — not source code, don't commit
examples/email_agent/drafts/

# Local runtime state. These directories hold the endpoint database and the
# Ed25519 trust-root PRIVATE KEY (data/trust_authority.json). Committing them
# would publish the key the whole trust chain verifies against.
.san-data/
.san-runtime/
.secureagentnet/
**/data/trust_authority.json
