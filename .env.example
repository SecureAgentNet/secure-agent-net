# SecureAgentNet Configuration
# Copy to .env and customize

# Environment
ENVIRONMENT=development

# Deployment mode:
#   docker    — full security (requires Docker, Redis, Ollama, Vault) — default
#   local     — SQLite + basic features (no Docker, no Redis, no Vault)
#   minimal   — JSON file storage, no external services at all
DEPLOY_MODE=docker

# Database (optional — all data stored in ~/.secureagentnet/data/ by default)
DATABASE_URL=postgresql://secureagent@localhost:5432/secureagentnet

# HashiCorp Vault (leave empty to skip vault logging)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=

# Ollama (local LLM for semantic evaluation)
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=30
OLLAMA_RETRY_COUNT=2

# Redis (rate limiting, caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=<generate-a-random-32-char-key>
AGENT_JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
KILL_SWITCH_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=60
BLOCK_THRESHOLD=0.7

# Container sandbox
CONTAINER_CPU_LIMIT=1.0
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_TIMEOUT_SECONDS=60
MCP_PORT=8443

# Dashboard (optional web UI)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_SECRET_KEY=<generate-a-random-32-char-key>

# Database Pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
