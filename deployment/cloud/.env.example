# Copy to deployment/cloud/.env and fill in. Never commit the real .env.
CLOUD_DB_USER=sancloud
CLOUD_DB_PASSWORD=change-me-strong-password
CLOUD_DB_NAME=sancloud

# Signing key for admin sessions/JWTs (generate: python -c "import secrets;print(secrets.token_hex(32))")
SAN_CLOUD_SECRET_KEY=change-me

# Optional seed admin (created on first start if no admin exists)
SAN_CLOUD_ADMIN_EMAIL=admin@secureagentnet.com
SAN_CLOUD_ADMIN_PASSWORD=change-me
