{
  "storage": {
    "raft": {
      "path": "/vault/file",
      "node_id": "node1"
    }
  },
  "listener": {
    "tcp": {
      "address": "0.0.0.0:8200",
      "tls_disable": false,
      "tls_cert_file": "/vault/config/tls.crt",
      "tls_key_file": "/vault/config/tls.key"
    }
  },
  "api_addr": "https://vault.securenet.internal:8200",
  "cluster_addr": "https://vault.securenet.internal:8201",
  "ui": true,
  "seal": {
    "awskms": {
      "region": "${AWS_REGION}",
      "kms_key_id": "${VAULT_KMS_KEY_ID}"
    }
  }
}
