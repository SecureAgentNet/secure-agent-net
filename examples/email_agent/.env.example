# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.

# --- Gmail ---
# Use a 16-character App Password, NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your Google account.)
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Agent behavior ---
# Comma-separated list of email addresses the agent will auto-reply to
# directly. Anyone NOT on this list gets a draft saved to drafts/ instead.
TRUSTED_SENDERS=teammate1@example.com,teammate2@example.com

# Your name, used to sign auto-drafted/auto-sent replies.
USER_NAME=Your Name