<!-- Fetch and Render Script -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>
<script is:inline>
    const API_HOST = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
        ? 'http://localhost:5000'
        : 'https://san-blog-api.onrender.com';

    const API_POST = (slug) => `${API_HOST}/api/v1/blog/posts/${slug}`;

    document.addEventListener('DOMContentLoaded', async () => {
        const urlParams = new URLSearchParams(window.location.search);
        const slug = urlParams.get('slug');

        const loadingState = document.getElementById('loadingState');
        const errorState = document.getElementById('errorState');
        const errorMessage = document.getElementById('errorMessage');
        const postContent = document.getElementById('postContent');

        if (!slug) {
            loadingState.classList.add('hidden');
            errorState.classList.remove('hidden');
            errorMessage.innerText = "No post identifier was provided.";
            return;
        }

        try {
            const res = await fetch(API_POST(slug));
            if (!res.ok) {
                if (res.status === 404) {
                    throw new Error("The requested blog post was not found.");
                }
                throw new Error(`Failed to load post. Server returned ${res.status}`);
            }

            const post = await res.json();

            // Populate fields
            document.title = `SAN | ${post.title}`;
            document.getElementById('postTitle').innerText = post.title;
            document.getElementById('postAuthor').innerText = post.author || 'SAN Operator';
            
            // Set Avatar Initials
            const authorName = post.author || 'O';
            const initial = authorName.charAt(0).toUpperCase();
            document.getElementById('authorAvatar').innerText = initial;

            // Date Formatting
            let formattedDate = 'OCT 2026';
            const dateField = post.published_at || post.created_at;
            if (dateField) {
                try {
                    const dateObj = new Date(dateField);
                    const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
                    formattedDate = `${months[dateObj.getMonth()]} ${dateObj.getDate()}, ${dateObj.getFullYear()}`;
                } catch(e) {}
            }
            document.getElementById('postDate').innerText = formattedDate;

            // Read Time & Tags
            document.getElementById('postReadTime').innerText = `${post.read_time || '5 MIN'} READ`;
            if (post.tags && post.tags.length > 0) {
                const tagNames = post.tags.map(t => t.name || t).filter(Boolean);
                if (tagNames.length > 0) {
                    document.getElementById('postTag').innerText = tagNames[0].toUpperCase();
                }
            }

            // Summary
            if (post.summary) {
                document.getElementById('postSummary').innerText = post.summary;
                document.getElementById('postSummaryContainer').classList.remove('hidden');
            }

            // Compile & Render Markdown Content
            const bodyContent = post.body || post.content || '';
            const htmlContent = marked.parse(bodyContent);
            document.getElementById('renderedMarkdown').innerHTML = htmlContent;

            // Set dynamic checksum/sig for aesthetic visual integration
            // Create a fake hash from the slug
            let hashVal = 0;
            for (let i = 0; i < slug.length; i++) {
                hashVal = (hashVal << 5) - hashVal + slug.charCodeAt(i);
                hashVal |= 0;
            }
            document.getElementById('integritySig').innerText = Math.abs(hashVal).toString(16).padEnd(24, 'f');

            // Toggle view states
            loadingState.classList.add('hidden');
            postContent.classList.remove('hidden');

            // Load comments
            loadComments(post.id || 0);

        } catch (err) {
            console.error(err);
            loadingState.classList.add('hidden');
            errorState.classList.remove('hidden');
            errorMessage.innerText = err.message || "An unexpected network error occurred.";
        }
    });

    // --- Comments ---
    const API_COMMENTS = `${API_HOST}/api/v1/blog/comments`;

    async function loadComments(postId) {
        const list = document.getElementById('commentsList');
        const count = document.getElementById('commentCount');
        if (!postId) {
            list.innerHTML = '<p class="text-on-surface-variant text-sm">Comments unavailable.</p>';
            return;
        }

        document.getElementById('commentPostId').value = postId;

        try {
            const res = await fetch(`${API_COMMENTS}?post_id=${postId}`);
            if (!res.ok) throw new Error('Failed to load comments');
            const comments = await res.json();
            count.textContent = Array.isArray(comments) ? comments.length : 0;

            if (!comments || comments.length === 0) {
                list.innerHTML = '<p class="text-on-surface-variant text-sm">No comments yet. Be the first.</p>';
                return;
            }

            list.innerHTML = comments.map(c => `
                <div class="bg-surface-container-lowest/50 border border-white/5 rounded-lg p-4">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-primary font-bold text-sm">${escapeHTML(c.author_name)}</span>
                        <span class="text-outline-variant text-xs font-mono">${formatDate(c.created_at)}</span>
                    </div>
                    <p class="text-on-surface-variant text-sm">${escapeHTML(c.body)}</p>
                </div>
            `).join('');
        } catch (err) {
            list.innerHTML = '<p class="text-on-surface-variant text-sm">Could not load comments.</p>';
        }
    }

    document.getElementById('commentForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = e.target.querySelector('button[type="submit"]');
        const successEl = document.getElementById('commentSuccess');
        const errorEl = document.getElementById('commentError');

        btn.disabled = true;
        successEl.classList.add('hidden');
        errorEl.classList.add('hidden');

        const body = {
            post_id: parseInt(document.getElementById('commentPostId').value),
            author_name: document.getElementById('commentName').value.trim(),
            author_email: document.getElementById('commentEmail').value.trim(),
            body: document.getElementById('commentBody').value.trim()
        };

        try {
            const res = await fetch(API_COMMENTS, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();

            if (!res.ok) {
                throw new Error(data.error || 'Submission failed');
            }

            document.getElementById('commentName').value = '';
            document.getElementById('commentEmail').value = '';
            document.getElementById('commentBody').value = '';
            successEl.classList.remove('hidden');
            loadComments(body.post_id);
        } catch (err) {
            errorEl.textContent = err.message;
            errorEl.classList.remove('hidden');
        } finally {
            btn.disabled = false;
        }
    });

    function escapeHTML(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function formatDate(dateStr) {
        try {
            const d = new Date(dateStr);
            const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
            return `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
        } catch(e) {
            return dateStr;
        }
    }

    // Mouse grid interaction
    document.addEventListener('mousemove', (e) => {
        const x = e.clientX;
        const y = e.clientY;
        document.body.style.backgroundImage = `
            radial-gradient(circle at ${x}px ${y}px, rgba(76, 215, 246, 0.08) 0%, transparent 250px),
            radial-gradient(circle at 2px 2px, rgba(6, 182, 212, 0.03) 1px, transparent 0)
        `;
    });
</script>
</body></html>
