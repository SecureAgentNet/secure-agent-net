<main class="flex-grow pt-24 pb-16 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
<div class="max-w-4xl mx-auto">
    <!-- Breadcrumbs / Back button -->
    <a href="/blog/" class="inline-flex items-center gap-2 text-primary hover:text-secondary transition-colors mb-8 font-label-caps text-label-caps">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Back to Intelligence mesh
    </a>

    <!-- Loading State -->
    <div id="loadingState" class="glass-panel p-12 rounded-xl text-center">
        <div class="inline-block w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin mb-4"></div>
        <p class="text-on-surface-variant font-code-md">Decrypting research feed...</p>
    </div>

    <!-- Error State -->
    <div id="errorState" class="glass-panel p-12 rounded-xl text-center hidden">
        <span class="material-symbols-outlined text-error text-5xl mb-4">warning</span>
        <h2 class="font-headline-md text-on-surface mb-2">Decryption Error</h2>
        <p class="text-on-surface-variant mb-6" id="errorMessage">The requested intelligence capsule could not be located or verified.</p>
        <a href="/blog/" class="bg-primary text-on-primary px-6 py-2.5 rounded font-label-caps text-label-caps hover:bg-primary-container transition-all">
            Return to Blog
        </a>
    </div>

    <!-- Post Article View -->
    <article id="postContent" class="hidden">
        <header class="mb-12">
            <div class="flex items-center gap-2 text-primary font-code-md text-code-md mb-4">
                <span class="bg-primary/10 px-2 py-0.5 rounded border border-primary/20" id="postTag">RESEARCH</span>
                <span>/</span>
                <span id="postReadTime">5 MIN READ</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg lg:text-display text-on-surface mb-6 leading-tight max-w-4xl" id="postTitle">
                <!-- Dynamic Title -->
            </h1>
            <div class="flex flex-wrap items-center gap-6">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full border border-secondary/40 bg-surface-container flex items-center justify-center text-primary font-bold" id="authorAvatar">
                        <!-- Initial -->
                    </div>
                    <div>
                        <p class="font-headline-md text-body-md text-on-surface" id="postAuthor"><!-- Dynamic Author --></p>
                        <p class="font-label-caps text-label-caps text-outline">Verified Operator</p>
                    </div>
                </div>
                <div class="h-8 w-px bg-white/10 hidden md:block" />
                <div class="flex items-center gap-2 text-on-surface-variant">
                    <span class="material-symbols-outlined text-[20px]">calendar_today</span>
                    <span class="font-code-md text-code-md" id="postDate"><!-- Dynamic Date --></span>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
            <!-- Main Content -->
            <div class="lg:col-span-8 space-y-8">
                <!-- Summary/Abstract if available -->
                <div id="postSummaryContainer" class="glass-panel p-8 rounded-xl relative overflow-hidden hidden">
                    <div class="absolute top-0 left-0 w-1 h-full bg-primary" />
                    <h2 class="font-headline-md text-headline-md text-primary mb-4">Abstract</h2>
                    <p class="text-body-lg text-on-surface-variant leading-relaxed" id="postSummary">
                        <!-- Dynamic Summary -->
                    </p>
                </div>

                <!-- Markdown Content rendered here -->
                <div class="rendered-content prose prose-invert max-w-none" id="renderedMarkdown">
                    <!-- Rendered HTML -->
                </div>
            </div>

            <!-- Sidebar -->
            <aside class="lg:col-span-4 space-y-gutter">
                <!-- Verification Info -->
                <div class="glass-panel p-6 rounded-xl">
                    <h3 class="font-headline-md text-label-caps text-primary mb-4">Integrity Certificate</h3>
                    <div class="space-y-4 font-code-md text-xs">
                        <div class="flex justify-between border-b border-white/5 pb-2">
                            <span class="text-outline">Algorithm:</span>
                            <span class="text-secondary">SHA-256</span>
                        </div>
                        <div class="flex justify-between border-b border-white/5 pb-2">
                            <span class="text-outline">Status:</span>
                            <span class="text-secondary">VERIFIED</span>
                        </div>
                        <div class="flex justify-between border-b border-white/5 pb-2">
                            <span class="text-outline">Signature:</span>
                            <span class="text-primary truncate w-32" id="integritySig"></span>
                        </div>
                        <p class="text-[10px] text-outline-variant italic">This publication has been cryptographic-signed and committed to the security mesh.</p>
                    </div>
                </div>

                <!-- Comments Section -->
                <div class="glass-panel p-6 rounded-xl" id="commentsSection">
                    <h3 class="font-headline-md text-label-caps text-primary mb-4">Comments (<span id="commentCount">0</span>)</h3>
                    <div id="commentsList" class="space-y-4 mb-6 max-h-96 overflow-y-auto custom-scrollbar">
                        <p class="text-on-surface-variant text-sm">Loading comments...</p>
                    </div>
                    <form id="commentForm" class="space-y-3">
                        <input type="hidden" id="commentPostId" />
                        <input type="text" id="commentName" placeholder="Your name" required
                               class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg p-2.5 text-sm text-on-background focus:outline-none focus:border-primary transition-all" />
                        <input type="email" id="commentEmail" placeholder="Your email" required
                               class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg p-2.5 text-sm text-on-background focus:outline-none focus:border-primary transition-all" />
                        <textarea id="commentBody" placeholder="Write a comment..." rows="3" required
                                  class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg p-2.5 text-sm text-on-background focus:outline-none focus:border-primary transition-all resize-none"></textarea>
                        <button type="submit"
                                class="bg-primary text-on-primary px-6 py-2 rounded font-label-caps text-label-caps hover:bg-primary-container transition-all w-full">
                            Submit Comment
                        </button>
                    </form>
                    <div id="commentSuccess" class="text-secondary text-xs mt-2 hidden">Comment submitted successfully!</div>
                    <div id="commentError" class="text-error text-xs mt-2 hidden"></div>
                </div>
            </aside>
        </div>
    </article>
</div>
</main>

