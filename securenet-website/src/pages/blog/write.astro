        const postTitle = document.getElementById('postTitle');
        const postSlug = document.getElementById('postSlug');
        const postAuthor = document.getElementById('postAuthor');
        const postReadTime = document.getElementById('postReadTime');
        const postTags = document.getElementById('postTags');
        const postSummary = document.getElementById('postSummary');

        const tabVisual = document.getElementById('tabVisual');
        const tabMarkdown = document.getElementById('tabMarkdown');
        const visualPane = document.getElementById('visualPane');
        const markdownPane = document.getElementById('markdownPane');
        
        const imageInput = document.getElementById('imageInput');
        const uploadStatus = document.getElementById('uploadStatus');
        const editorWordCount = document.getElementById('editorWordCount');
        const publishBtn = document.getElementById('publishBtn');
        const publishToast = document.getElementById('publishToast');

        const draftAlert = document.getElementById('draftAlert');
        const restoreDraftBtn = document.getElementById('restoreDraftBtn');
        const discardDraftBtn = document.getElementById('discardDraftBtn');

        // Check authentication token
        const checkAuth = () => {
            const token = localStorage.getItem('san_bearer_token');
            if (token) {
                authGate.classList.add('hidden');
                editorWorkspace.classList.remove('hidden');
                initEditor();
            } else {
                authGate.classList.remove('hidden');
                editorWorkspace.classList.add('hidden');
            }
        };

        // Login authentication – against FastAPI (keep for operator auth)
        authBtn.addEventListener('click', async () => {
            const username = authUsername.value.trim();
            const password = authPassword.value.trim();
            authError.classList.add('hidden');

            if (!username || !password) return;

            try {
                // Try local FastAPI auth first (for dev); fallback to skip gate
                const res = await fetch(`${getApiBaseUrl()}/api/v1/auth/operator-login?username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}`, {
                    method: 'POST'
                });

                if (res.ok) {
                    const data = await res.json();
                    localStorage.setItem('san_bearer_token', data.access_token);
                    localStorage.setItem('san_operator_name', data.user.username);
                } else {
                    // If FastAPI is not available (PHP-only mode), accept any credentials
                    // In production, redirect to PHP admin panel: window.location.href = ADMIN_URL;
                    localStorage.setItem('san_bearer_token', 'php-session-token');
                    localStorage.setItem('san_operator_name', username || 'SAN Operator');
                }

                postAuthor.value = localStorage.getItem('san_operator_name');
                checkAuth();
            } catch (err) {
                // FastAPI not reachable – allow entry for PHP-only setup
                localStorage.setItem('san_bearer_token', 'php-session-token');
                localStorage.setItem('san_operator_name', username || 'SAN Operator');
                postAuthor.value = localStorage.getItem('san_operator_name');
                checkAuth();
            }
        });

        // Auto Slugification from title
        postTitle.addEventListener('input', () => {
            const title = postTitle.value;
            const slug = title.toLowerCase()
                .replace(/[^a-z0-9\s-]/g, '') // remove special characters
                .replace(/\s+/g, '-') // spaces to hyphens
                .replace(/-+/g, '-'); // collapse multiple hyphens
            postSlug.value = slug;
            saveDraft();
        });

        // Tabs Toggle Logic
        let activeTab = 'visual';

        tabVisual.addEventListener('click', () => {
            if (activeTab === 'visual') return;
            activeTab = 'visual';
            
            // Sync markdown to HTML inside visual editor
            const md = markdownPane.value;
            visualPane.innerHTML = marked.parse(md);
            
            // Toggle visual classes
            tabVisual.classList.add('bg-primary/10', 'border-primary/30', 'text-primary');
            tabVisual.classList.remove('text-outline-variant');
            tabMarkdown.classList.remove('bg-primary/10', 'border-primary/30', 'text-primary');
            tabMarkdown.classList.add('text-outline-variant');
            
            visualPane.classList.remove('hidden');
            markdownPane.classList.add('hidden');
        });

        tabMarkdown.addEventListener('click', () => {
            if (activeTab === 'markdown') return;
            activeTab = 'markdown';
            
            // Sync Visual HTML to Markdown Source
            const html = visualPane.innerHTML;
            markdownPane.value = htmlToMarkdown(html);
            
            // Toggle visual classes
            tabMarkdown.classList.add('bg-primary/10', 'border-primary/30', 'text-primary');
            tabMarkdown.classList.remove('text-outline-variant');
            tabVisual.classList.remove('bg-primary/10', 'border-primary/30', 'text-primary');
            tabVisual.classList.add('text-outline-variant');
            
            markdownPane.classList.remove('hidden');
            visualPane.classList.add('hidden');
        });

        // Word count tracker
        const updateWordCount = () => {
            const text = visualPane.innerText || visualPane.textContent || '';
            const words = text.trim().split(/\s+/).filter(w => w.length > 0);
            editorWordCount.innerText = `${words.length} Words`;
        };
        visualPane.addEventListener('input', updateWordCount);

        // Standard rich text formatting tool bar button listeners
        const execFormat = (cmd, val = null) => {
            document.execCommand(cmd, false, val);
            visualPane.focus();
            updateWordCount();
            saveDraft();
        };

        // Standard Toolbar Button Listeners (prevent focus collapse on mousedown)
        const addToolbarAction = (id, cmd, promptMsg = null, promptVal = '') => {
            const btn = document.getElementById(id);
            if (!btn) return;
            btn.addEventListener('mousedown', (e) => e.preventDefault()); // keep selection active
            btn.addEventListener('click', () => {
                if (promptMsg) {
                    const val = prompt(promptMsg, promptVal);
                    if (val) execFormat(cmd, val);
                } else {
                    execFormat(cmd);
                }
            });
        };

        addToolbarAction('tbBold', 'bold');
        addToolbarAction('tbItalic', 'italic');
        addToolbarAction('tbH1', 'formatBlock', null, '<h1>');
        addToolbarAction('tbH2', 'formatBlock', null, '<h2>');
        addToolbarAction('tbUl', 'insertUnorderedList');
        addToolbarAction('tbOl', 'insertOrderedList');
        addToolbarAction('tbClear', 'removeFormat');
        
        // Link Insertion
        const tbLink = document.getElementById('tbLink');
        tbLink.addEventListener('mousedown', (e) => e.preventDefault());
        tbLink.addEventListener('click', () => {
            const url = prompt("Enter hyperlink URL (e.g. https://google.com):", "https://");
            if (url) {
                execFormat('createLink', url);
            }
        });

        // Floating Selection formatting bubble
        const floatingToolbar = document.getElementById('floatingToolbar');
        const showFloatingToolbar = () => {
            if (activeTab !== 'visual') return;
            const selection = window.getSelection();
            if (!selection || selection.isCollapsed || selection.toString().trim() === "") {
                floatingToolbar.classList.add('hidden');
                return;
            }
            
            // Check if selection is within the visual editor
            const range = selection.getRangeAt(0);
            const container = range.commonAncestorContainer;
            if (!visualPane.contains(container.nodeType === Node.TEXT_NODE ? container.parentNode : container)) {
                floatingToolbar.classList.add('hidden');
                return;
            }
            
            const rect = range.getBoundingClientRect();
            // Position above selection
            floatingToolbar.classList.remove('hidden');
            const tbWidth = floatingToolbar.offsetWidth;
            const tbHeight = floatingToolbar.offsetHeight;
            
            const top = rect.top + window.scrollY - tbHeight - 12;
            const left = rect.left + window.scrollX + (rect.width / 2) - (tbWidth / 2);
            
            floatingToolbar.style.top = `${top}px`;
            floatingToolbar.style.left = `${Math.max(10, left)}px`;
        };

        // Attach mouseup/keyup selection triggers
        document.addEventListener('selectionchange', showFloatingToolbar);
        window.addEventListener('resize', () => floatingToolbar.classList.add('hidden'));
        window.addEventListener('scroll', () => floatingToolbar.classList.add('hidden'));

        // Floating Bubble Button Action Setup
        const addBubbleAction = (id, cmd, isBlock = false) => {
            const btn = document.getElementById(id);
            btn.addEventListener('mousedown', (e) => e.preventDefault());
            btn.addEventListener('click', () => {
                if (isBlock) {
                    execFormat('formatBlock', cmd);
                } else {
                    execFormat(cmd);
                }
                floatingToolbar.classList.add('hidden');
            });
        };

        addBubbleAction('fbBold', 'bold');
        addBubbleAction('fbItalic', 'italic');
        addBubbleAction('fbH1', '<h1>', true);
        addBubbleAction('fbH2', '<h2>', true);
        
        const fbLink = document.getElementById('fbLink');
        fbLink.addEventListener('mousedown', (e) => e.preventDefault());
        fbLink.addEventListener('click', () => {
            const url = prompt("Enter hyperlink URL:", "https://");
            if (url) {
                execFormat('createLink', url);
            }
            floatingToolbar.classList.add('hidden');
        });

        // Asset image uploading client logic – via PHP API
        const uploadFile = async (file) => {
            if (!file.type.startsWith('image/')) {
                alert("Only image uploads are allowed.");
                return;
            }

            uploadStatus.classList.remove('hidden');

            const formData = new FormData();
            formData.append('file', file);

            try {
                const res = await fetch(API_UPLOAD, {
                    method: 'POST',
                    body: formData
                });

                if (!res.ok) throw new Error("Asset upload failed");
                const data = await res.json();
                
                // Embed the served image URL into selection
                const imgUrl = data.url;
                execFormat('insertImage', imgUrl);
            } catch (err) {
                alert("Error uploading image: " + err.message);
            } finally {
                uploadStatus.classList.add('hidden');
            }
        };

        // File Selector image trigger
        const tbImage = document.getElementById('tbImage');
        tbImage.addEventListener('click', () => {
            imageInput.click();
        });
        imageInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                uploadFile(e.target.files[0]);
            }
        });

        // Drag & Drop visual container support
        visualPane.addEventListener('dragover', (e) => {
            e.preventDefault();
            visualPane.style.borderColor = '#4cd7f6';
        });

        visualPane.addEventListener('dragleave', () => {
            visualPane.style.borderColor = '';
        });

        visualPane.addEventListener('drop', (e) => {
            e.preventDefault();
            visualPane.style.borderColor = '';
            if (e.dataTransfer.files.length > 0) {
                uploadFile(e.dataTransfer.files[0]);
            }
        });

        // Clipboard Copy & Paste images support
        visualPane.addEventListener('paste', (e) => {
            const items = (e.clipboardData || e.originalEvent.clipboardData).items;
            for (let item of items) {
                if (item.type.indexOf('image') === 0) {
                    e.preventDefault();
                    const blob = item.getAsFile();
                    uploadFile(blob);
                }
            }
        });

        // Draft Auto-Saving System
        const saveDraft = () => {
            const draft = {
                title: postTitle.value,
                slug: postSlug.value,
                author: postAuthor.value,
                readTime: postReadTime.value,
                tags: postTags.value,
                summary: postSummary.value,
                htmlContent: visualPane.innerHTML,
                timestamp: Date.now()
            };
            localStorage.setItem('san_blog_draft', JSON.stringify(draft));
        };

        // Save local draft manually
        document.getElementById('saveDraftLocalBtn').addEventListener('click', () => {
            saveDraft();
            alert("Draft saved locally successfully!");
        });

        // Periodical save
        let saveTimer;
        const initEditor = () => {
            updateWordCount();
            
            // Check for existing drafts
            const draftStr = localStorage.getItem('san_blog_draft');
            if (draftStr) {
                const draft = JSON.parse(draftStr);
                // Only prompt if there is some meaningful content
                if (draft.title || (draft.htmlContent && draft.htmlContent !== '<br>')) {
                    draftAlert.classList.remove('hidden');
                }
            }

            // Start autosave
            saveTimer = setInterval(saveDraft, 5000);
        };

        // Restore / Discard Draft
        restoreDraftBtn.addEventListener('click', () => {
            const draft = JSON.parse(localStorage.getItem('san_blog_draft'));
            if (draft) {
                postTitle.value = draft.title || '';
                postSlug.value = draft.slug || '';
                postAuthor.value = draft.author || 'admin';
                postReadTime.value = draft.readTime || '5 MIN';
                postTags.value = draft.tags || '';
                postSummary.value = draft.summary || '';
                visualPane.innerHTML = draft.htmlContent || '';
                updateWordCount();
            }
            draftAlert.classList.add('hidden');
        });

        discardDraftBtn.addEventListener('click', () => {
            localStorage.removeItem('san_blog_draft');
            draftAlert.classList.add('hidden');
        });

        // Publish Post to Mesh – via PHP API
        publishBtn.addEventListener('click', async () => {
            const title = postTitle.value.trim();
            const slug = postSlug.value.trim();
            const author = postAuthor.value.trim();
            const readTime = postReadTime.value.trim();
            const tags = postTags.value.split(',').map(t => t.trim()).filter(t => t.length > 0);
            const summary = postSummary.value.trim();
            
            // Gather content
            const bodyContent = activeTab === 'visual' ? htmlToMarkdown(visualPane.innerHTML) : markdownPane.value;

            if (!title || !slug || !bodyContent) {
                alert("Validation error: Title, Slug, and Content are required parameters.");
                return;
            }

            publishBtn.disabled = true;
            publishBtn.innerText = "Synchronizing...";

            const token = localStorage.getItem('san_bearer_token');

            try {
                // Publish via PHP API
                const res = await fetch(API_POSTS, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        title,
                        slug,
                        author: author || 'SAN Operator',
                        read_time: readTime || '5 MIN',
                        tags,
                        summary,
                        content: bodyContent,
                    })
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.error || "Failed to publish logs");
                }

                // Successful publish
                localStorage.removeItem('san_blog_draft'); // clear draft
                publishToast.classList.remove('hidden');

                // Redirect to post page
                setTimeout(() => {
                    window.location.href = `/blog/post?slug=${slug}`;
                }, 2000);

            } catch (err) {
                alert("Publish failed: " + err.message);
                publishBtn.disabled = false;
                publishBtn.innerText = "Publish Post";
            }
        });

        // Initial setup run
        checkAuth();
    });
</script>
</body></html>
