---
import SiteLayout from '../layouts/SiteLayout.astro';
import PipelineStory from '../components/PipelineStory.astro';
import Terminal from '../components/Terminal.astro';

const CLONE_CMD = 'git clone https://github.com/SecureAgentNet/secure-agent-net.git';

const stats = [
  { value: '97.0%', count: '97.0', suffix: '%', label: 'Attack detection', sub: '94.5-98.2% over 3 runs' },
  { value: '0%', count: null, suffix: '', label: 'Hard false positives', sub: 'No benign request denied' },
  { value: '6/6', count: null, suffix: '', label: 'Goal hijacks caught', sub: '3/6 without mandates' },
  { value: '~2ms', count: null, suffix: '', label: 'Fast-path decisions', sub: 'Deterministic tier, no LLM' },
];

const frameworks = [
  { name: 'LangChain', copy: 'Wrap any AgentExecutor in the ITCD pipeline with a single call.' },
  { name: 'CrewAI', copy: 'Govern multi-agent crews and stop lateral data leaks between collaborators.' },
  { name: 'AutoGen', copy: 'Harden AutoGen agents that touch the file system or the web.' },
];
---

<SiteLayout title="SecureAgentNet — Runtime security for AI agents">
  <main class="pt-16">
    <!-- Hero -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pt-16 md:pt-28 pb-16 md:pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6">
          <h1 class="font-display text-display text-on-surface mb-6">
            Your agents have credentials. Attackers know it.
          </h1>
          <p class="text-on-surface-variant text-body-lg max-w-lg mb-9 leading-relaxed">
            SecureAgentNet checks every agent action against the goal the agent was
            actually commissioned for, and blocks the ones that don't serve it.
            Identity, audit, containment, decision: all before anything executes.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center mb-5">
            <button class="cmd-pill" data-copy={CLONE_CMD} type="button" aria-label="Copy clone command">
              <span class="select-none text-stone-500">$</span>
              <span class="whitespace-nowrap overflow-x-auto max-w-[78vw] sm:max-w-[340px] lg:max-w-[400px]">{CLONE_CMD}</span>
              <span class="cmd-copy" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
              </span>
            </button>
            <a class="btn-secondary" href="/install">Install guide</a>
          </div>
          <p class="text-sm text-on-surface-variant">
            MIT licensed. Runs entirely on your own infrastructure.
          </p>
        </div>
        <div class="lg:col-span-6">
          <Terminal title="san">
            <div><span class="text-stone-500">$</span> <span class="t-cmd">san agent commission payroll-bot --goal "Pay employee salaries to registered accounts"</span></div>
            <div><span class="t-ok">Agent commissioned</span> <span class="t-dim">mandate active, expires 60m</span></div>
            <div class="mt-3"><span class="text-stone-500">$</span> <span class="t-cmd">san run payroll-bot "transfer 48,200 -&gt; acct 0xATTACKER"</span></div>
            <div><span class="t-deny">ACTION BLOCKED</span> <span class="t-dim">phase DECIDE, risk 1.0</span></div>
            <div class="t-dim">Reason: deviates from commissioned goal -- goal hijacking</div>
          </Terminal>
        </div>
      </div>
    </section>

    <!-- Evidence strip -->
    <section class="border-y border-outline-variant bg-surface-container-low">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-10 md:py-12">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-y-8 md:divide-x md:divide-outline-variant">
          {stats.map((s) => (
            <div class="md:px-8 first:md:pl-0">
              <div class="font-display text-3xl md:text-4xl font-bold text-on-surface mb-1" data-count={s.count} data-suffix={s.suffix}>{s.value}</div>
              <div class="text-on-surface text-sm font-medium">{s.label}</div>
              <div class="text-on-surface-variant text-xs mt-0.5">{s.sub}</div>
            </div>
          ))}
        </div>
        <p class="text-sm text-on-surface-variant mt-8">
          Measured against the OWASP LLM Top-10 through the live decision gateway, reported
          as mean and range over three independent runs.
          <a class="text-primary font-medium hover:underline underline-offset-4" href="/evaluation">Read the full evaluation and ablation study</a>
        </p>
      </div>
    </section>

    <!-- Scroll-driven ITCD pipeline story -->
    <PipelineStory />

    <!-- Capabilities -->
    <section class="py-12 md:py-20 space-y-20 md:space-y-32">
      <!-- Mandate enforcement -->
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
        <div class="reveal">
          <p class="text-sm font-semibold text-primary mb-3">Mandate enforcement</p>
          <h2 class="font-headline-lg text-headline-lg text-on-surface mb-5">Agents only do what they were hired to do</h2>
          <p class="text-on-surface-variant leading-relaxed mb-6">
            Commission an agent with a mandate: the goal it's sanctioned to pursue. Every
            action is then judged against that mandate, so a hijacked agent is blocked even
            when its credentials are flawless. No mandate, no action. The gateway fails closed.
          </p>
          <a class="text-primary text-sm font-medium hover:underline underline-offset-4" href="/features">How intent verification works</a>
        </div>
        <Terminal title="san evaluate" class="reveal">
          <div><span class="text-stone-500">$</span> <span class="t-cmd">san evaluate transfer_funds --agent payroll-bot --intent "Pay June salary to Alice"</span></div>
          <div><span class="t-ok">ALLOWED</span> <span class="t-dim">risk 0.00, serves commissioned goal</span></div>
          <div class="mt-3"><span class="text-stone-500">$</span> <span class="t-cmd">san evaluate transfer_funds --agent payroll-bot --intent "Divert payroll to external account"</span></div>
          <div><span class="t-deny">DENIED</span> <span class="t-dim">risk 1.00, goal hijacking detected</span></div>
        </Terminal>
      </div>

      <!-- MCP vetting -->
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
        <Terminal title="san mcp vet" class="order-2 lg:order-1 reveal">
          <div><span class="text-stone-500">$</span> <span class="t-cmd">san mcp vet ./weather-server/manifest.json</span></div>
          <div class="t-dim">MCP Vetting -- server 'weather-server'</div>
          <div><span class="t-cmd">get_forecast</span>   <span class="t-ok">SAFE</span>       0.05</div>
          <div><span class="t-cmd">read_settings</span>  <span class="t-deny">MALICIOUS</span>  0.92  <span class="t-dim">hidden instruction in description</span></div>
          <div class="t-warn mt-1">1 tool(s) flagged MALICIOUS -- agents will be blocked from using them</div>
        </Terminal>
        <div class="order-1 lg:order-2 reveal">
          <p class="text-sm font-semibold text-primary mb-3">MCP tool vetting</p>
          <h2 class="font-headline-lg text-headline-lg text-on-surface mb-5">Poisoned tools never reach your agents</h2>
          <p class="text-on-surface-variant leading-relaxed">
            Before an agent trusts an MCP server, SecureAgentNet scans every tool description
            for injected instructions, pins a content hash to catch silent rug-pulls, and
            scopes each tool to the agent's mandate.
          </p>
        </div>
      </div>

      <!-- Sandbox -->
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
        <div class="reveal">
          <p class="text-sm font-semibold text-primary mb-3">Kernel-hardened sandbox</p>
          <h2 class="font-headline-lg text-headline-lg text-on-surface mb-5">Contained before it's judged</h2>
          <p class="text-on-surface-variant leading-relaxed">
            Every action is provisioned into an ephemeral container with seccomp-bpf, AppArmor,
            a read-only rootfs and no network by default, before the decision is even made. A
            denied action's sandbox is torn down without ever executing.
          </p>
        </div>
        <Terminal title="san run" class="reveal">
          <div><span class="text-stone-500">$</span> <span class="t-cmd">san run email-bot "python parse.py"</span></div>
          <div class="t-dim">[CONTAIN] sandbox provisioned, seccomp + read-only rootfs, network: none</div>
          <div><span class="t-ok">ACTION ALLOWED &amp; EXECUTED</span></div>
          <div class="t-dim">Sandbox: sbx-0c03, exit 0, 412ms</div>
          <div class="t-dim">Vault receipt: hmac:2b81...e9f4</div>
        </Terminal>
      </div>

      <!-- Audit -->
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
        <Terminal title="san logs" class="order-2 lg:order-1 reveal">
          <div><span class="text-stone-500">$</span> <span class="t-cmd">san logs tail payroll-bot</span></div>
          <div class="t-dim">[TRACK] reasoning captured, vault-signed hmac:9f3a...c41d</div>
          <div class="t-dim">[DECIDE] denied, goal deviation, risk 1.0</div>
          <div class="mt-3"><span class="text-stone-500">$</span> <span class="t-cmd">san logs verify 9f3a...c41d</span></div>
          <div><span class="t-ok">Log verified</span> <span class="t-dim">signature valid, entry untampered</span></div>
        </Terminal>
        <div class="order-1 lg:order-2 reveal">
          <p class="text-sm font-semibold text-primary mb-3">Tamper-evident audit</p>
          <h2 class="font-headline-lg text-headline-lg text-on-surface mb-5">Evidence that can't be edited</h2>
          <p class="text-on-surface-variant leading-relaxed">
            The agent's reasoning is captured as it happens and every event is HMAC-signed
            through HashiCorp Vault. Each decision is reconstructable, each receipt
            independently verifiable.
          </p>
        </div>
      </div>
    </section>

    <!-- Frameworks -->
    <section class="border-t border-outline-variant bg-surface-container-low">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-16 md:py-24">
        <div class="max-w-2xl mb-12">
          <h2 class="font-headline-lg text-headline-lg text-on-surface mb-3">Works with the frameworks you already use</h2>
          <p class="text-on-surface-variant">One line of code wraps your existing agents in the ITCD pipeline.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {frameworks.map((f, i) => (
            <div class={`raised p-6 rounded-lg reveal delay-${i + 1}`}>
              <h3 class="text-on-surface font-semibold mb-2">{f.name}</h3>
              <p class="text-on-surface-variant text-sm leading-relaxed mb-4">{f.copy}</p>
              <a class="text-primary text-sm font-medium hover:underline underline-offset-4" href="/docs">Integration guide</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20 md:py-28 px-margin-mobile md:px-margin-desktop">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-on-surface mb-5">Start securing your agents</h2>
        <p class="text-on-surface-variant mb-9">Clone the repository, commission an agent, and watch a hijack get blocked in your own terminal.</p>
        <div class="flex flex-col items-center gap-4">
          <button class="cmd-pill" data-copy={CLONE_CMD} type="button" aria-label="Copy clone command">
            <span class="select-none text-stone-500">$</span>
            <span class="whitespace-nowrap overflow-x-auto max-w-[78vw] sm:max-w-none">{CLONE_CMD}</span>
            <span class="cmd-copy" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            </span>
          </button>
          <a class="text-primary text-sm font-medium hover:underline underline-offset-4" href="/install">Then follow the five-minute install guide</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Copy-to-clipboard for command pills
    document.querySelectorAll('[data-copy]').forEach((el) => {
      el.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(el.getAttribute('data-copy') || '');
          el.classList.add('opacity-80');
          setTimeout(() => el.classList.remove('opacity-80'), 400);
        } catch { /* clipboard unavailable — command stays selectable */ }
      });
    });

    // Count-up for evidence stats
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counters = document.querySelectorAll('[data-count]');
    if (motionOk && counters.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const target = parseFloat(el.dataset.count || '');
          if (Number.isNaN(target)) return;
          const suffix = el.dataset.suffix || '';
          const t0 = performance.now();
          const dur = 1100;
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = (target * eased).toFixed(1) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.5 });
      counters.forEach((el) => { if ((el as HTMLElement).dataset.count) io.observe(el); });
    }
  </script>
</SiteLayout>
