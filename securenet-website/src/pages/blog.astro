    <script>
        // Point to your PHP backend (update this URL to your Hetzner server)
        const API_HOST = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
            ? 'http://localhost:5000'
            : 'https://secureagentnet.com';

        const API_POSTS = `${API_HOST}/api/v1/blog/posts`;

        async function fetchDynamicPosts() {
            try {
                const res = await fetch(API_POSTS);
                if (!res.ok) return;
                const result = await res.json();
                const posts = result.data || result;
                
                const grid = document.getElementById('articleGrid');
                if (!grid) return;
                
                posts.forEach(post => {
                    // Extract first image if available
                    const imgRegex = /!\[.*?\]\((.*?)\)/;
                    const bodyContent = post.body || post.content || '';
                    const match = bodyContent.match(imgRegex);
                    let imgSrc = match ? match[1] : '/assets/4d53715b7935f2120191409baa601b2b.png';
                    
                    // Format date
                    let formattedDate = 'OCT 2026';
                    if (post.created_at) {
                        try {
                            const dateObj = new Date(post.created_at);
                            const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
                            formattedDate = `${months[dateObj.getMonth()]} ${dateObj.getDate()}, ${dateObj.getFullYear()}`;
                        } catch(e) {}
                    }
                    
                    // Create tags markup
                    const tagsMarkup = (post.tags || []).map(t => 
                        `<span class="bg-black/80 text-primary text-[10px] font-code-md px-2 py-0.5 border border-primary/30">#${t}</span>`
                    ).join(' ');

                    const article = document.createElement('article');
                    article.className = 'glass-card flex flex-col group';
                    article.innerHTML = `
                        <div class="h-48 overflow-hidden relative">
                            <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 opacity-60 group-hover:opacity-100" src="${imgSrc}" alt="${post.title}" />
                            <div class="absolute bottom-3 left-3 flex gap-2">
                                ${tagsMarkup || '<span class="bg-black/80 text-secondary text-[10px] font-code-md px-2 py-0.5 border border-secondary/30">#Research</span>'}
                            </div>
                        </div>
                        <div class="p-6 flex flex-col flex-grow">
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-primary font-code-md text-code-md">${formattedDate}</span>
                                <span class="text-outline-variant text-xs flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">schedule</span> ${post.read_time || '5 MIN'}
                                </span>
                            </div>
                            <h3 class="font-headline-md text-headline-md mb-4 text-on-surface group-hover:text-primary transition-colors">
                                <a href="/blog/post?slug=${post.slug}">${post.title}</a>
                            </h3>
                            <p class="text-on-surface-variant text-body-sm mb-6 flex-grow">
                                ${post.summary || ''}
                            </p>
                            <div class="flex items-center justify-between pt-6 border-t border-white/5">
                                <div class="flex items-center gap-3">
                                    <div class="w-6 h-6 rounded-full bg-surface-container border border-secondary/40 flex items-center justify-center text-[10px] font-bold text-primary">${(post.author || 'O').charAt(0).toUpperCase()}</div>
                                    <span class="font-label-caps text-[10px] text-on-surface">${post.author.toUpperCase()}</span>
                                </div>
                                <a href="/blog/post?slug=${post.slug}" class="material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors">arrow_outward</a>
                            </div>
                        </div>
                    `;
                    grid.appendChild(article);
                });
            } catch (err) {
                console.error("Failed to fetch dynamic posts:", err);
            }
        }

        document.addEventListener('DOMContentLoaded', fetchDynamicPosts);

        // Micro-interaction for the terminal input
        const terminalInput = document.getElementById('terminalInput');
        terminalInput.addEventListener('input', (e) => {
            if(e.target.value.length > 0) {
                // Future: add typing sound or specific effects
            }
        });

        // Sticky header glow logic
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 20) {
                nav.classList.add('shadow-[0_4px_30px_rgba(0,0,0,0.5)]');
            } else {
                nav.classList.remove('shadow-[0_4px_30px_rgba(0,0,0,0.5)]');
            }
        });

        // Active filter toggle
        const categoryButtons = document.querySelectorAll('button.font-label-caps');
        categoryButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                categoryButtons.forEach(b => {
                    b.classList.remove('bg-primary', 'text-on-primary');
                    b.classList.add('bg-white/5', 'text-on-surface-variant');
                });
                btn.classList.add('bg-primary', 'text-on-primary');
                btn.classList.remove('bg-white/5', 'text-on-surface-variant');
            });
        });
    </script>


</body></html>