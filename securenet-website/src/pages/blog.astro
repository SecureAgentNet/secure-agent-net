---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured.id);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<SiteLayout title="Blog — SecureAgentNet">
  <main class="pt-32 pb-16 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
    <header class="mb-12 max-w-2xl">
      <h1 class="font-display text-display text-on-surface mb-3">Blog</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant">
        Notes on securing autonomous AI agents: the threats, the architecture, and the case for
        building the trust boundary before the ecosystem ossifies.
      </p>
    </header>

    <!-- Featured -->
    <a href={`/blog/${featured.id}/`} class="block mb-14 group">
      <article class="raised rounded-lg p-8 lg:p-12">
        <div class="flex items-center gap-3 mb-5 text-xs font-semibold uppercase tracking-wide">
          <span class="text-primary">Featured</span>
          <span class="text-on-surface-variant font-normal normal-case">{featured.data.readTime} read</span>
        </div>
        <h2 class="font-display text-2xl md:text-4xl font-bold mb-4 text-on-surface leading-tight group-hover:text-primary transition-colors max-w-3xl">{featured.data.title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mb-6 max-w-2xl">{featured.data.description}</p>
        <div class="text-sm text-on-surface-variant">{featured.data.authors.join(', ')} &mdash; {fmt(featured.data.date)}</div>
      </article>
    </a>

    <!-- Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-gutter">
      {rest.map((p) => (
        <a href={`/blog/${p.id}/`} class="block group">
          <article class="raised rounded-lg flex flex-col h-full p-6">
            <div class="flex justify-between items-center mb-4 text-xs text-on-surface-variant">
              <span>{fmt(p.data.date)}</span>
              <span>{p.data.readTime} read</span>
            </div>
            <h3 class="font-headline-md text-[18px] mb-3 text-on-surface group-hover:text-primary transition-colors">{p.data.title}</h3>
            <p class="text-on-surface-variant text-body-sm mb-6 flex-grow">{p.data.description}</p>
            <div class="flex items-center justify-between pt-4 border-t border-outline-variant">
              <span class="text-xs text-on-surface-variant">{p.data.authors.join(', ')}</span>
              <div class="flex gap-2">
                {p.data.tags.slice(0, 2).map((t) => (
                  <span class="bg-surface-container-high text-on-surface-variant text-[10px] font-code-md px-2 py-0.5 border border-outline-variant rounded">{t}</span>
                ))}
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>
  </main>
</SiteLayout>